{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "oNote",
  "version": "0.2.0",
  "identifier": "com.onote.notes",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "oNote",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "alwaysOnTop": false,
        "center": true,
        "backgroundColor": "#0b0f17"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Programmer's notes and syntax",
    "longDescription": "oNote is a note-taking app for developers, security engineers, DevOps, AI engineers, and data analysts. Track skills, capture notes, store snippets, and review what you learn with a built-in spaced-repetition system."
  },
  "plugins": {}
}
